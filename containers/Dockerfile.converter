# syntax=docker/dockerfile:1.7
FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 AS build
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates gcc git make && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone https://github.com/marijnheule/drat-trim.git . && git checkout --detach 2e3b2dc0ecf938addbd779d42877b6ed69d9a985
RUN gcc drat-trim.c -std=c99 -O2 -static -o drat-trim && strip drat-trim

FROM scratch
COPY --from=build /src/drat-trim /drat-trim
USER 65532:65532
ENTRYPOINT ["/drat-trim"]
